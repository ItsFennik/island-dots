// Island on niri: copy these into ~/.config/niri/config.kdl.
// (`spawn` doesn't expand ~, hence the sh -c wrappers.)

// Generated by Island Settings / themes (niri 25.11+ for include):
include "island.kdl"          // gaps, border width, input, cursor, rounding, animations
include "island-theme.kdl"    // border colours

// One startup script: session dirs, dbus, PipeWire on non-systemd, clipboard,
// wallpaper and Quickshell. (`spawn-at-startup` doesn't expand ~.)
spawn-at-startup "sh" "-c" "~/.config/quickshell/island/scripts/island-startup"

binds {
    Mod+D            { spawn "qs" "-c" "island" "ipc" "call" "launcher" "toggle"; }
    Mod+A            { spawn "qs" "-c" "island" "ipc" "call" "launchpad" "toggle"; }
    Mod+C            { spawn "qs" "-c" "island" "ipc" "call" "menu" "notifs"; }
    Mod+V            { spawn "qs" "-c" "island" "ipc" "call" "menu" "clipboard"; }
    Mod+M            { spawn "qs" "-c" "island" "ipc" "call" "media" "toggle"; }
    Mod+I            { spawn "qs" "-c" "island" "ipc" "call" "settings" "toggle"; }
    Mod+W            { spawn "qs" "-c" "island" "ipc" "call" "picker" "wallpapers"; }
    Mod+Alt+W        { spawn "qs" "-c" "island" "ipc" "call" "picker" "themes"; }
    Mod+Escape       { spawn "qs" "-c" "island" "ipc" "call" "menu" "power"; }
    Mod+Ctrl+Q       { spawn "qs" "-c" "island" "ipc" "call" "lock" "lock"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "qs" "-c" "island" "ipc" "call" "volume" "up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "qs" "-c" "island" "ipc" "call" "volume" "down"; }
    XF86AudioMute        allow-when-locked=true { spawn "qs" "-c" "island" "ipc" "call" "volume" "mute"; }
    XF86AudioPlay        allow-when-locked=true { spawn "qs" "-c" "island" "ipc" "call" "media" "playPause"; }
    XF86AudioNext        allow-when-locked=true { spawn "qs" "-c" "island" "ipc" "call" "media" "next"; }
    XF86AudioPrev        allow-when-locked=true { spawn "qs" "-c" "island" "ipc" "call" "media" "previous"; }
}
