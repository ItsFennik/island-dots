[Unit]
Description=Island desktop shell
Documentation=https://github.com/ItsFennik/island-dots
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=@TARGET@/scripts/island-startup --foreground --no-pipewire
Restart=on-failure
RestartSec=1
TimeoutStopSec=5

[Install]
WantedBy=graphical-session.target
